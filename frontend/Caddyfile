# SITE_ADDRESS examples:
#   20-40-60-80.sslip.io   -> real HTTPS certificate via Let's Encrypt (recommended)
#   :80                    -> plain HTTP (quick test only; Google login needs HTTPS)
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@backend path /api/* /admin/queues* /health
	handle @backend {
		reverse_proxy backend:4000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}
}
