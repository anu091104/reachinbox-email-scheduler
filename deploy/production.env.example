# Copy to the repo root as .env.production and fill in. Never commit the filled-in file.

# Your VM's public IP with dashes + .sslip.io, e.g. 20-193-45-12.sslip.io
# (sslip.io resolves it back to the IP, and Caddy gets a free HTTPS certificate for it)
SITE_ADDRESS=20-193-45-12.sslip.io
COOKIE_SECURE=true

POSTGRES_PASSWORD=pick-a-long-random-password
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-64+-random-hex-characters-here
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=pick-another-strong-password

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
SEND_GAP_SCOPE=sender
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50
AUTO_PROVISION_SENDERS=3
