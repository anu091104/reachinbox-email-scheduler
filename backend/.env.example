# ─────────────────────────────────────────────────────────────────────────────
#  ReachInbox Email Scheduler — backend configuration
#  Copy to .env and adjust. Every value here is read and validated in src/config/env.ts
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Storage (these match docker-compose.yml)
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=scheduled-emails

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=4f9a1c...(96 characters)...e2b7
# OAuth 2.0 Client ID (type "Web application") from console.cloud.google.com
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false

# Worker
WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_MS=30000
SEND_LEASE_MS=60000

# Throughput controls
# Minimum gap between two sends. Scope "sender" = per mailbox, "global" = across all mailboxes.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
SEND_GAP_SCOPE=sender
# 0 disables a limit
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# SMTP (Ethereal). Senders are stored in the DB; this many are auto-created on first boot.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
AUTO_PROVISION_SENDERS=3

# BullMQ dashboard at http://localhost:4000/admin/queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-please
